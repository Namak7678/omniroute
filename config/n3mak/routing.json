  "defaultModel": "cfp/openai/gpt-oss-20b",
  "fallbackModels": [
    "cfp/zai-org/glm-4.7-flash",
    "cfp/openai/gpt-oss-120b",
    "cfp/moonshotai/kimi-k2.6",
    "xai/grok-4.3",
    "xai/grok-4.6",
    "xai/grok-4.20-0309-non-reasoning",
    "xai/grok-build-0.1"
  ],
  "providerIds": {
    "freePlayground": "cloudflare-playground",
    "freeAlias": "cfp",
    "apiKey": "xai",
    "oauth": "xai-oauth",
    "oauthAlias": "xao",
    "grokWeb": "grok-web",
    "grokCli": "grok-cli"
  },
  "upstream": {
    "chatCompletions": "https://api.x.ai/v1/chat/completions",
