      "OMNIROUTE_BASE_URL",
      "N3MAK_DEFAULT_MODEL",
      "OMNIROUTE_GROK_TLS_TIMEOUT_MS",
      "OMNIROUTE_GROK_TLS_GRACE_MS",
      "GROK_AUTH_PATH",
      "GROK_OAUTH_CLIENT_ID",
      "GROQ_API_KEY",
      "GEMINI_API_KEY",
      "OPENROUTER_API_KEY",
      "ANTHROPIC_API_KEY"
    ]
  }
}