{
  "profile": "n3mak-grok",
  "description": "Prefer official xAI Grok via OmniRoute OpenAI-compatible /v1",
  "baseUrl": "http://127.0.0.1:20128/v1",
  "defaultModel": "xai/grok-4.3",
  "fallbackModels": [
    "xai/grok-4.6",
    "xai/grok-4.20-0309-non-reasoning",
    "xai/grok-build-0.1"
  ],
  "providerIds": {
    "apiKey": "xai",
    "oauth": "xai-oauth",
    "oauthAlias": "xao",
    "grokWeb": "grok-web",
    "grokCli": "grok-cli"
  },
  "upstream": {
    "chatCompletions": "https://api.x.ai/v1/chat/completions",
    "responses": "https://api.x.ai/v1/responses",
    "console": "https://console.x.ai"
  },
  "envVars": {
    "requiredForLiveGrok": ["XAI_API_KEY"],
    "optional": [
      "OMNIROUTE_API_KEY",
      "OMNIROUTE_BASE_URL",
      "N3MAK_DEFAULT_MODEL",
      "OMNIROUTE_GROK_TLS_TIMEOUT_MS",
      "OMNIROUTE_GROK_TLS_GRACE_MS",
      "GROK_AUTH_PATH",
      "GROK_OAUTH_CLIENT_ID"
    ]
  }
}
