# =============================================================================
# N3mak + OmniRoute — free-first (no xAI billing required)
# =============================================================================
# Copy into `.env` (or merge the keys you need). Do NOT commit real secrets.
#
# Free path (recommended):
#   1. npm install && npx playwright install chromium
#   2. npm run dev
#   3. npm run n3mak:smoke-free
#   4. Point N3mak_Bot at http://127.0.0.1:20128/v1 with OPENAI_MODEL below
#
# Optional paid Grok upgrade: set XAI_API_KEY then npm run n3mak:activate
# =============================================================================

# --- Core OmniRoute ----------------------------------------------------------
PORT=20128
NODE_ENV=development
INITIAL_PASSWORD=CHANGEME

# Auto-generated on first `npm install` / sync-env — keep these local:
# JWT_SECRET=
# API_KEY_SECRET=
# STORAGE_ENCRYPTION_KEY=

# --- Free default (Cloudflare AI Playground, no API key) ---------------------
# Verified live: cfp/openai/gpt-oss-20b
N3MAK_DEFAULT_MODEL=cfp/openai/gpt-oss-20b
N3MAK_FALLBACK_MODEL=cfp/zai-org/glm-4.7-flash

# OmniRoute OpenAI-compatible base URL (for N3mak_Bot and smoke scripts)
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# Optional OmniRoute API key (dashboard → Keys). Free/local often accepts any bearer.
OMNIROUTE_API_KEY=n3mak-local

# --- Optional: Official xAI / Grok API (paid / billed) -----------------------
# Only if you want official Grok later — NOT required for the free path.
# XAI_API_KEY=
# Then: npm run n3mak:activate && set N3MAK_DEFAULT_MODEL=xai/grok-4.3

# --- Optional: Grok web TLS sidecar ------------------------------------------
# OMNIROUTE_GROK_TLS_TIMEOUT_MS=60000
# OMNIROUTE_GROK_TLS_GRACE_MS=10000
# GROK_AUTH_PATH=

# --- N3mak_Bot bridge hints --------------------------------------------------
# OPENAI_BASE_URL=${OMNIROUTE_BASE_URL}
# OPENAI_API_KEY=${OMNIROUTE_API_KEY:-n3mak-local}
# OPENAI_MODEL=${N3MAK_DEFAULT_MODEL}
