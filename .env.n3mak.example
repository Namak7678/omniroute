# =============================================================================
# N3mak + OmniRoute — Grok / xAI ready profile
# =============================================================================
# Copy into `.env` (or merge the keys you need). Do NOT commit real secrets.
#
# After install:
#   1. cp .env.n3mak.example .env   # or merge into the auto-generated .env
#   2. Put your official xAI API key in XAI_API_KEY (console.x.ai)
#   3. npm run n3mak:activate      # wires the xAI provider connection
#   4. Point N3mak_Bot / any OpenAI client at http://localhost:20128/v1
#
# Live Grok calls require XAI_API_KEY. Everything else can start without it.
# =============================================================================

# --- Core OmniRoute ----------------------------------------------------------
PORT=20128
NODE_ENV=development
INITIAL_PASSWORD=CHANGEME

# Auto-generated on first `npm install` / sync-env — keep these local:
# JWT_SECRET=
# API_KEY_SECRET=
# STORAGE_ENCRYPTION_KEY=

# --- Official xAI / Grok API (first-class provider id: xai) -------------------
# Get a key at https://console.x.ai — OmniRoute talks to https://api.x.ai/v1
XAI_API_KEY=

# Default model routed for N3mak (OpenAI-compatible id: provider/model)
# Catalog (v3.8.50): grok-4.6, grok-4.3, grok-4.20-*, grok-build-0.1
# OAuth-only extra: grok-4.5 (via xai-oauth / dashboard Sign in with xAI)
N3MAK_DEFAULT_MODEL=xai/grok-4.3
N3MAK_FALLBACK_MODEL=xai/grok-4.6

# OmniRoute OpenAI-compatible base URL (for N3mak_Bot and smoke scripts)
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# Optional OmniRoute API key (dashboard → Keys). Free/local often accepts any bearer.
OMNIROUTE_API_KEY=

# --- Optional: Grok web TLS sidecar (browser-fingerprinted path) -------------
# Only needed for grok-web / Grok CLI session paths — NOT for XAI_API_KEY.
# OMNIROUTE_GROK_TLS_TIMEOUT_MS=60000
# OMNIROUTE_GROK_TLS_GRACE_MS=10000
# GROK_AUTH_PATH=

# --- Optional: xAI OAuth (SuperGrok) -----------------------------------------
# Prefer dashboard "Sign in with xAI" or: omniroute providers auth xai-oauth
# GROK_OAUTH_CLIENT_ID=

# --- N3mak_Bot bridge hints (read by docs / smoke; bot may copy these) -------
# OPENAI_BASE_URL=${OMNIROUTE_BASE_URL}
# OPENAI_API_KEY=${OMNIROUTE_API_KEY:-n3mak-local}
# OPENAI_MODEL=${N3MAK_DEFAULT_MODEL}
